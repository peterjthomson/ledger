{
  "name": "ledger",
  "version": "1.5.1",
  "description": "A modern git interface for macOS - view branches, worktrees, and pull requests",
  "main": "./out/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Peter Thomson",
    "url": "https://github.com/peterjthomson"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -w",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "vite:build:app": "electron-vite build",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:mac:arm64": "electron-builder --mac --arm64",
    "electron:build:mac:x64": "electron-builder --mac --x64",
    "electron:build:mac:universal": "electron-builder --mac --universal",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:dir": "electron-builder --dir",
    "build:unpack": "run-s vite:build:app electron:build:dir",
    "build:win": "run-s vite:build:app electron:build:win",
    "build:mac": "run-s vite:build:app electron:build:mac && xattr -cr dist/mac-*/Ledger.app",
    "build:mac:arm64": "run-s vite:build:app electron:build:mac:arm64 && ./scripts/check-app-size.sh && xattr -cr dist/mac-arm64/Ledger.app",
    "build:mac:x64": "run-s vite:build:app electron:build:mac:x64 && xattr -cr dist/mac-x64/Ledger.app",
    "build:mac:universal": "run-s vite:build:app electron:build:mac:universal && xattr -cr dist/mac-universal/Ledger.app",
    "build:mas": "run-s vite:build:app && ./scripts/build-mas.sh",
    "build:linux": "run-s vite:build:app electron:build:linux",
    "release": "run-s vite:build:app && electron-builder --mac --publish always",
    "test": "cross-env ELECTRON_RUN_AS_NODE= playwright test",
    "test:headed": "cross-env ELECTRON_RUN_AS_NODE= playwright test --headed",
    "pretest": "npm run vite:build:app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peterjthomson/ledger"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "fix-path": "^5.0.0",
    "lucide-react": "^1.27.0",
    "openai": "^6.49.0",
    "react-json-view-lite": "^2.5.0",
    "shiki": "^4.3.1",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "tldraw": "^5.2.5",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.42.2",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  }
}

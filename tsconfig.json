{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["electron-vite/node"],
    "noEmit": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*", "lib/**/*", "resources/**/*", "tests/**/*", "electron.vite.config.*", "playwright*.config.ts"]
}
